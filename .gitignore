# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.
# Monorepo: client/ (Next.js) e server/ (Node.js) — padrões valem em qualquer pasta.

# dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage/

# next.js
.next/
out/

# production
build/
dist/

# env files (segredos) — nunca versionar
.env
.env.*
*.env
# ...mas manter os arquivos de exemplo
!env.exemple
!exemple.env
!.env.example

# dados gerados em tempo de execução (recriado automaticamente pelo app)
client/src/data/vouchers-meta.json
client/src/data/*.tmp

# logs / debug
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# PM2
.pm2/

# certificados / chaves
*.pem
*.key
*.crt

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# OS
.DS_Store
Thumbs.db
desktop.ini

# editores
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/

# Claude Code (configurações locais)
.claude/settings.local.json
